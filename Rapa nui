            </div>

            <h3>
              Trámites
            </h3>

            <p>
              Información y acceso a servicios municipales.
            </p>

          </a>


          <a href="#agenda" class="quick-card">

            <div class="quick-icon">
              02
            </div>

            <h3>
              Agenda
            </h3>

            <p>
              Actividades, reuniones y eventos de la comunidad.
            </p>

          </a>


          <a href="#noticias" class="quick-card">

            <div class="quick-icon">
              03
            </div>

            <h3>
              Noticias
            </h3>

            <p>
              Información y actualidad del municipio.
            </p>

          </a>


          <a href="#transparencia" class="quick-card">

            <div class="quick-icon">
              04
            </div>

            <h3>
              Transparencia
            </h3>

            <p>
